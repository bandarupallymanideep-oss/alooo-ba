# ==============================================================================
# SADARAKSHAK Backend Environment Configuration Example
# Copy this file to backend/.env on your server or set these environment variables.
# ==============================================================================

# Allowed origins for CORS (comma separated). Add your deployed Vercel domain here!
# Example: https://nirikshan.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:3000

# Path to YOLOv11 model weights (defaults to model/best.pt relative to backend/)
SADARAKSHAK_MODEL_PATH=model/best.pt

# Inference device: auto | cpu | cuda | intel:gpu | intel:npu | intel:cpu
SADARAKSHAK_INFERENCE_DEVICE=auto

# Detection confidence thresholds
SADARAKSHAK_CONFIDENCE_THRESHOLD=0.85
SADARAKSHAK_DISPLAY_CONFIDENCE=0.25

# Accident verification window
SADARAKSHAK_MIN_ACCIDENT_HITS=2
SADARAKSHAK_CONFIRM_WINDOW_S=1.5
SADARAKSHAK_MIN_HIT_RATIO=0.4
SADARAKSHAK_REQUIRE_ROAD_CONTEXT=1

# Video stream timeouts and retries
SADARAKSHAK_STREAM_OPEN_TIMEOUT_MS=15000
SADARAKSHAK_STREAM_READ_TIMEOUT_MS=8000
SADARAKSHAK_RECONNECT_ATTEMPTS=5
SADARAKSHAK_RECONNECT_DELAY_S=3.0
